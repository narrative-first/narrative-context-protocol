{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://narrativecontextprotocol.org/core/ncp-core-schema.json",
    "title": "Narrative Context Protocol Core",
    "description": "Narrative-system-neutral envelope for transporting narrative context, authorial intent, provenance, profiles, extensions, and certification metadata.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "ncp_version",
        "document",
        "story"
    ],
    "properties": {
        "ncp_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "document": {
            "$ref": "#/$defs/document"
        },
        "story": {
            "$ref": "#/$defs/story"
        },
        "profiles": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/profileDeclaration"
            },
            "uniqueItems": true
        },
        "extensions": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/extensionDeclaration"
            },
            "uniqueItems": true
        },
        "storytelling_moments": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/storytellingMoment"
            }
        },
        "contributions": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/contribution"
            }
        },
        "payloads": {
            "type": "object",
            "description": "Profile- and extension-owned data keyed by declared namespace. NCP Core does not interpret payload semantics.",
            "additionalProperties": true
        }
    },
    "$defs": {
        "uri": {
            "type": "string",
            "format": "uri"
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "document": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "created_at"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "created_at": {
                    "$ref": "#/$defs/timestamp"
                },
                "updated_at": {
                    "$ref": "#/$defs/timestamp"
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "authorship": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/party"
                    }
                },
                "provenance": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/provenance"
                    }
                }
            }
        },
        "story": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "title": {
                    "type": "string"
                },
                "logline": {
                    "type": "string"
                },
                "external_references": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/reference"
                    }
                }
            }
        },
        "party": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "role"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "name": {
                    "type": "string"
                },
                "role": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "system",
                "value"
            ],
            "properties": {
                "system": {
                    "type": "string",
                    "minLength": 1
                },
                "value": {
                    "type": "string",
                    "minLength": 1
                },
                "uri": {
                    "$ref": "#/$defs/uri"
                },
                "entity_type": {
                    "type": "string"
                }
            }
        },
        "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "at",
                "action"
            ],
            "properties": {
                "at": {
                    "$ref": "#/$defs/timestamp"
                },
                "action": {
                    "type": "string",
                    "minLength": 1
                },
                "actor_id": {
                    "type": "string"
                },
                "source": {
                    "$ref": "#/$defs/reference"
                }
            }
        },
        "profileDeclaration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "namespace",
                "profile_version",
                "schema"
            ],
            "properties": {
                "namespace": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*:$"
                },
                "profile_version": {
                    "type": "string",
                    "minLength": 1
                },
                "schema": {
                    "$ref": "#/$defs/uri"
                }
            }
        },
        "extensionDeclaration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "namespace",
                "version",
                "schema"
            ],
            "properties": {
                "namespace": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*:$"
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "schema": {
                    "$ref": "#/$defs/uri"
                }
            }
        },
        "storytellingMoment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "summary"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "summary": {
                    "type": "string"
                },
                "references": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/reference"
                    }
                }
            }
        },
        "contribution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "contributor_id",
                "at"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "contributor_id": {
                    "type": "string",
                    "minLength": 1
                },
                "at": {
                    "$ref": "#/$defs/timestamp"
                },
                "summary": {
                    "type": "string"
                }
            }
        }
    }
}
